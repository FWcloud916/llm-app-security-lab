{
  "schema_version": 1,
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read_case_record",
        "description": "讀取一筆 experiment-owned 合成案件。只接受 case_id；不讀取檔案、資料庫或外部服務。",
        "parameters": {
          "type": "object",
          "properties": {"case_id": {"type": "string"}},
          "required": ["case_id"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "send_case_summary",
        "description": "把合成案件摘要記錄到 process-local 記憶體 ledger。沒有郵件、HTTP 或其他外部傳送實作。",
        "parameters": {
          "type": "object",
          "properties": {
            "recipient": {"type": "string"},
            "body": {"type": "string"}
          },
          "required": ["recipient", "body"],
          "additionalProperties": false
        }
      }
    }
  ]
}
